{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode-ai/builder-api",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
