  "devDependencies": {
    "@types/bun": "1.2.5",
    "@tsconfig/bun": "1.0.9",
    "@cloudflare/workers-types": "4.20250320.0",
    "wrangler": "4.5.1",
    "typescript": "5.8.2",
    "vitest": "3.0.0",
    "@vitest/coverage-v8": "3.0.0",
    "miniflare": "4.20250320.0"
