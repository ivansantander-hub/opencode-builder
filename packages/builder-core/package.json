{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode-ai/builder-core",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "private": true,
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "test": "vitest",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "db": "drizzle-kit"
  },
  "dependencies": {
    "drizzle-orm": "0.40.0",
    "zod": "3.24.2",
    "ulid": "3.0.1",
    "effect": "3.14.0"
  },
  "devDependencies": {
    "@types/bun": "1.2.5",
    "@tsconfig/bun": "1.0.9",
    "@cloudflare/workers-types": "4.20250320.0",
    "drizzle-kit": "0.30.5",
    "typescript": "5.8.2",
    "vitest": "3.0.0",
    "@vitest/coverage-v8": "3.0.0"
  }
}
